+def stage_verified_local_view(proposal, *, root, incoming, objects,
+                              max_state_bytes=2*1024**4):
+    """Re-use hardlinks so a cached 300B checkpoint is not copied on staging.
+
+    The caller must ensure the source is a verified, content-addressed local
+    snapshot download. Every linked shard is independently rehashed here.
+    """
+    from .epoch_objects_v50 import digest_ok
+    digest=proposal.get('manifest')
+    if not digest_ok(digest) or not digest_ok(proposal.get('semantic')):
+        raise PatchError('invalid certified candidate hashes')
+    root=Path(root);incoming=Path(incoming);objects=Path(objects)
+    target=root/'checkpoints'/'views'/digest
+    if (target.is_symlink() or incoming.is_symlink() or objects.is_symlink() or
+            root.is_symlink()):
+        raise PatchError('unsafe snapshot cache source')
+    current=target/'checkpoint.fmanifest'
+    if current.is_file():
+        candidate=SimpleNamespace(manifest=current,store=target)
+        verify_candidate_files(candidate,proposal,max_state_bytes=max_state_bytes)
+        return candidate
+    source=incoming/(digest+'.fmanifest')
+    if source.is_symlink() or not source.is_file():
+        raise FileNotFoundError('certified checkpoint not locally downloaded')
+    h=hashlib.sha256()
+    with source.open('rb') as fp:
+        for part in iter(lambda:fp.read(1024*1024),b''):h.update(part)
+    if h.hexdigest()!=digest:raise PatchError('downloaded certified manifest hash mismatch')
+    meta=read_manifest(source,max_state_bytes=max_state_bytes)
+    if semantic_shard_sha256(meta)!=proposal['semantic']:
+        raise PatchError('downloaded checkpoint semantic hash mismatch')
+    verify_shards(meta,objects)
+    target.mkdir(parents=True,exist_ok=True)
+    if target.is_symlink():raise PatchError('unsafe checkpoint view')
+    def link(src,dst):
+        if src.is_symlink():raise PatchError('unsafe snapshot shard link source')
+        dst.parent.mkdir(parents=True,exist_ok=True)
+        if dst.is_symlink():raise PatchError('unsafe destination snapshot link')
+        if not dst.exists():os.link(src,dst)
+        elif not os.path.samefile(src,dst):
+            raise PatchError('checkpoint view collision')
+        _sync_dir(dst.parent)
+    link(source,current)
+    for key in shard_map(meta):
+        link(_blob_path(objects,key),_blob_path(target,key))
+    candidate=SimpleNamespace(manifest=current,store=target)
+    verify_candidate_files(candidate,proposal,max_state_bytes=max_state_bytes)
+    _sync_dir(target)
+    _sync_dir(target.parent)
+    return candidate
