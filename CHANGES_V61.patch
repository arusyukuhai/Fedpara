+def test_poisoned_sparse_store_rejects_later_reads(tmp_path,monkeypatch):
+    import os
+    base=torch.zeros((2000,20),dtype=torch.float32)
+    store=SparsePageStore(base,tmp_path/'pages',page_bytes=4096)
