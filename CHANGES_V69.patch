@@ -0,0 +1,134 @@
+"""Pinned HF sequence value critic for PPO, trained locally and never shared as P2P adapter.
+
+Reward Model scores finished responses. This model instead predicts per-action
+state values using *prefixes* of the generated response and is optimized by PPO
+value loss. The tokenizer can differ from the actor tokenizer. Only an already
+trained scalar HF head is used; its frozen backbone never enters the optimizer.
+"""
+from __future__ import annotations
+import math
+import re
+from pathlib import Path
+
+import torch
+from torch import nn
+
+REPO = re.compile(r'^[A-Za-z0-9][A-Za-z0-9_.-]{0,95}/[A-Za-z0-9][A-Za-z0-9_.-]{0,95}$')
+SHA = re.compile(r'^[a-fA-F0-9]{40}$')
+
+
+class HFValueError(ValueError):
+    pass
+
+
+def critic_spec(args):
+    if getattr(args, 'critic_kind', 'mlp') != 'hf':
+        return None
+    repo=str(getattr(args,'critic_hf_repo','') or '').strip()
+    rev=str(getattr(args,'critic_hf_revision','') or '').strip()
+    loader=str(getattr(args,'critic_hf_loader','sequence_classification'))
+    device=str(getattr(args,'critic_hf_device','cpu'))
+    limit=getattr(args,'critic_hf_max_length',512)
+    if not REPO.fullmatch(repo) or not SHA.fullmatch(rev):
+        raise HFValueError('HF Critic requires organization/model and a pinned 40-character commit SHA')
+    if loader not in ('sequence_classification','token_classification'):
+        raise HFValueError('HF Critic loader must be scalar sequence or token classification')
+    if device not in ('cpu','cuda','mps'):
+        raise HFValueError('HF Critic device must be cpu/cuda/mps')
+    if type(limit) is not int or not 16<=limit<=8192:
+        raise HFValueError('HF Critic max input must be 16..8192 tokens')
+    return {'repo':repo,'revision':rev.lower(),'loader':loader,'max_length':limit,
+            'trainable':'scalar_head_only-v1','trust_remote_code':False}
+
+
+class HFValueCritic(nn.Module):
+    def __init__(self,args,*,model=None,tokenizer=None):
+        super().__init__()
+        self.spec=critic_spec(args)
+        if self.spec is None:raise HFValueError('HF Critic not selected')
+        device=str(getattr(args,'critic_hf_device','cpu'))
+        if device=='cuda' and not torch.cuda.is_available():
+            raise HFValueError('Requested CUDA for HF Critic is unavailable')
+        if device=='mps' and not torch.backends.mps.is_available():
+            raise HFValueError('Requested MPS for HF Critic is unavailable')
+        self.device=torch.device(device)
+        if model is None or tokenizer is None:
+            try:
+                from transformers import AutoModelForSequenceClassification, AutoModelForTokenClassification, AutoTokenizer
+                kw={'revision':self.spec['revision'],'trust_remote_code':False,
+                    'use_safetensors':True,'output_loading_info':True}
+                cls=AutoModelForSequenceClassification if self.spec['loader']=='sequence_classification' else AutoModelForTokenClassification
+                if model is None:
+                    try:loaded=cls.from_pretrained(self.spec['repo'],dtype='auto',**kw)
+                    except TypeError as exc:
+                        if 'dtype' not in str(exc):raise
+                        loaded=cls.from_pretrained(self.spec['repo'],torch_dtype='auto',**kw)
+                    if not isinstance(loaded,tuple) or len(loaded)!=2:
+                        raise HFValueError('HF Critic loader did not return weight-loading diagnostics')
+                    model,info=loaded
+                    if info.get('missing_keys') or info.get('mismatched_keys'):
+                        raise HFValueError('HF Critic head/weights are missing or mismatched; refusing random initialization')
+                if tokenizer is None:
+                    tokenizer=AutoTokenizer.from_pretrained(self.spec['repo'],revision=self.spec['revision'],trust_remote_code=False)
+            except Exception as exc:
+                if isinstance(exc,HFValueError):raise
+                raise HFValueError(f'Cannot load pinned HF Critic safely: {exc}') from exc
+        if getattr(getattr(model,'config',None),'num_labels',None)!=1:
+            raise HFValueError('HF Critic must expose a PRETRAINED single scalar value head (num_labels=1)')
+        candidates=[]
+        for name,layer in model.named_modules():
+            if (isinstance(layer,nn.Linear) and layer.out_features==1 and
+                (name.split('.')[-1] in ('score','classifier','value_head','v_head','value','reward_head') or
+                 'classifier' in name.lower())):
+                candidates.append((name,layer))
+        if len(candidates)!=1:
+            raise HFValueError('Need exactly one trained scalar value head (Linear out_features=1); found '+str(len(candidates)))
+        self.head_name,self.head=candidates[0]
+        self.model=model.to(self.device)
+        for p in self.model.parameters():p.requires_grad_(False)
+        for p in self.head.parameters():p.requires_grad_(True)
+        self.model.eval()  # deterministic old/current value predictions
+        self.tok=tokenizer
+        # New completions must stay visible when the shared context exceeds
+        # the Critic's maximum input length. Its tokenizer is actor-independent.
+        if hasattr(self.tok,'truncation_side'):
+            self.tok.truncation_side='left'
+        self.calls=0
+
+    def trainable_parameters(self):
+        return list(self.head.parameters())
+
+    def values(self,prefixes,*,actor_device):
+        if not isinstance(prefixes,list) or not 1<=len(prefixes)<=128:
+            raise HFValueError('Expected 1..128 PPO state prefixes')
+        self.model.eval()
+        outputs=[]
+        for text in prefixes:
+            if not isinstance(text,str) or not text or len(text)>65536:
+                raise HFValueError('Empty/oversized PPO critic prefix')
+            batch=self.tok(text,return_tensors='pt',truncation=True,max_length=self.spec['max_length'])
+            if not isinstance(batch,dict) and not hasattr(batch,'items'):
+                raise HFValueError('HF Critic tokenizer must return a tensor mapping')
+            tensors={k:v.to(self.device) for k,v in batch.items() if k in ('input_ids','attention_mask','token_type_ids')}
+            if 'input_ids' not in tensors or tensors['input_ids'].ndim!=2 or tensors['input_ids'].shape[0]!=1 or tensors['input_ids'].shape[1]==0:
+                raise HFValueError('HF Critic tokenizer returned invalid input_ids')
+            result=self.model(**tensors)
+            logits=result.get('logits') if isinstance(result,dict) else getattr(result,'logits',None)
+            if not isinstance(logits,torch.Tensor):raise HFValueError('HF Critic must return logits tensor')
+            if self.spec['loader']=='sequence_classification':
+                if logits.shape!=(1,1):raise HFValueError('Sequence HF Critic logits must be [1,1]')
+                value=logits[0,0]
+            else:
+                if logits.ndim!=3 or logits.shape[0]!=1 or logits.shape[2]!=1 or logits.shape[1]!=tensors['input_ids'].shape[1]:
+                    raise HFValueError('Token HF Critic logits must be [1,tokens,1]')
+                if 'attention_mask' in tensors:
+                    index=int(tensors['attention_mask'][0].sum().item())-1
+                else:index=logits.shape[1]-1
+                value=logits[0,index,0]
+            if not torch.isfinite(value):raise HFValueError('HF Critic returned nonfinite state value')
+            outputs.append(value.float().to(actor_device))
+            self.calls+=1
+        return torch.stack(outputs)
+
+    def snapshot_weights(self):
+        return {name:p.detach().cpu().contiguous().clone() for name,p in self.head.named_parameters()}
--- a/patchlib/hf_critic_state_v69.py
+++ b/patchlib/hf_critic_state_v69.py
@@ -0,0 +1,80 @@
+"""Data-only, crash-atomic HF value-head and AdamW state; pinned HF base is reloaded from Hub."""
+from __future__ import annotations
+import json
+import os
+import secrets
+from pathlib import Path
+import torch
+from safetensors import safe_open
+from safetensors.torch import save_file,load_file
+from .hf_value_critic_v69 import HFValueError
+
+
+def snapshot_file(root):return Path(root)/'critic-hf-v69.safetensors'
+
+
+def _identity(critic,identity):
+    return json.dumps({'spec':critic.spec,'head':critic.head_name,'room':str(identity)},sort_keys=True,separators=(',',':'))
+
+
+def save(root,critic,optimizer,*,identity,steps):
+    folder=Path(root).expanduser()
+    if folder.is_symlink():raise HFValueError('Symlink Critic directory forbidden')
+    folder.mkdir(parents=True,exist_ok=True,mode=0o700)
+    target=snapshot_file(folder)
+    tensors={'h.'+k:v for k,v in critic.snapshot_weights().items()}
+    params=critic.trainable_parameters()
+    for i,p in enumerate(params):
+        state=optimizer.state.get(p,{})
+        for k in ('step','exp_avg','exp_avg_sq'):
+            if isinstance(state.get(k),torch.Tensor):tensors[f'o.{i}.{k}']=state[k].detach().cpu().contiguous().clone()
+    if not tensors or any(not torch.isfinite(v).all() for v in tensors.values()):
+        raise HFValueError('Invalid HF Critic checkpoint tensors')
+    if sum(x.numel()*x.element_size() for x in tensors.values())>128*1024**2:
+        raise HFValueError('HF Critic head+optimizer exceeds 128MiB; reduce head size')
+    tmp=folder/('.hf-critic-'+secrets.token_hex(10)+'.tmp')
+    try:
+        save_file(tensors,str(tmp),metadata={'format':'kagami-hf-value-head-v69','identity':_identity(critic,identity),'steps':str(steps)})
+        with tmp.open('rb') as f:os.fsync(f.fileno())
+        os.replace(tmp,target)
+        d=os.open(folder,os.O_RDONLY)
+        try:os.fsync(d)
+        finally:os.close(d)
+    finally:tmp.unlink(missing_ok=True)
+
+
+def load(path,critic,optimizer,*,identity):
+    path=Path(path)
+    if not path.is_file() or path.stat().st_size>129*1024**2:
+        raise HFValueError('HF Critic checkpoint missing or oversized')
+    with safe_open(str(path),framework='pt',device='cpu') as f:meta=f.metadata() or {}
+    if meta.get('format')!='kagami-hf-value-head-v69' or meta.get('identity')!=_identity(critic,identity):
+        raise HFValueError('HF Critic checkpoint base revision/head/room mismatch')
+    weights=load_file(str(path),device='cpu')
+    expected={'h.'+k:v for k,v in critic.snapshot_weights().items()}
+    params=critic.trainable_parameters()
+    allowed=set(expected)
+    for key,v in expected.items():
+        if key not in weights or weights[key].shape!=v.shape or weights[key].dtype!=v.dtype:
+            raise HFValueError('HF Critic head state mismatch')
+    for i,p in enumerate(params):
+        present={k for k in ('step','exp_avg','exp_avg_sq') if f'o.{i}.{k}' in weights}
+        if present and present!={'step','exp_avg','exp_avg_sq'}:
+            raise HFValueError('Incomplete HF Critic AdamW state')
+        for k in present:
+            key=f'o.{i}.{k}';v=weights[key];allowed.add(key)
+            if k=='step':
+                if v.numel()!=1 or float(v.item())<0:raise HFValueError('Invalid AdamW step')
+            elif v.shape!=p.shape or v.dtype!=p.dtype:raise HFValueError('HF Critic optimizer layout mismatch')
+    if allowed!=set(weights) or any(not torch.isfinite(v).all() for v in weights.values()):
+        raise HFValueError('Unexpected or nonfinite HF Critic state')
+    steps=int(meta['steps'])
+    if not 0<=steps<2**63:raise HFValueError('Invalid HF Critic checkpoint steps')
+    # Validation is complete; mutate only trainable head and optimizer.
+    with torch.no_grad():
+        for k,p in critic.head.named_parameters():p.copy_(weights['h.'+k].to(p.device))
+    optimizer.state.clear()
+    for i,p in enumerate(params):
+        state={k:weights[f'o.{i}.{k}'].clone().to(p.device) for k in ('step','exp_avg','exp_avg_sq') if f'o.{i}.{k}' in weights}
+        if state:optimizer.state[p]=state
+    return steps
