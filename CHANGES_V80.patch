+def test_gap_repair_and_equivocation(tmp_path):
+    a,b,ma,mb,mixa,mixb=peers(tmp_path)
+    try:
+        first=a.local(sample());second=a.local(sample())
+        b.ingest(second)
+        assert b.need(a.frontiers())==[('alpha',1)]
