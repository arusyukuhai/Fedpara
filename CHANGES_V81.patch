+def test_repeat_policy_content_addressed_no_retransmission(tmp_path):
+    a,b,src,dst,ma,mb=peers(tmp_path)
+    try:
+        data,ck=rollout(src,ma)
+        first=a.local(data,checkpoint=ck)
+        again=a.local(data,checkpoint=ck)
