+
+This operates only on complete content-addressed local shards. Network fetches
+are handled independently by the existing resumable snapshot transport.
+Publishing a view never certifies a checkpoint or a journal cut by itself.
+"""
+from __future__ import annotations
+
+import hashlib
+import os
+from pathlib import Path
