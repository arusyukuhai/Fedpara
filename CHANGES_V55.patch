+    journal = _journal(tmp_path, 'cut')
+    try:
+        journal.append('alice', 1, b'a')
+        runner = _cut_runner(journal, [('alice', 1, hashlib.sha256(b'a').hexdigest())])
+        runner.validate_cut()
+        with journal.db:
+            journal.db.execute('UPDATE events SET digest=? WHERE origin=? AND seq=?', ('f'*64, 'alice', 1))
