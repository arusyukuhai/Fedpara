+    y=_FrozenDiskConv1D.apply(x2,None,src,tuple(base.shape),base.dtype,None)
+    src.append([2*v for v in now],old)
+    y.sum().backward()
+    assert torch.allclose(x2.grad,torch.ones((2,7))@old_weight.T,atol=1e-5)
