+            while True:
+                now = time.monotonic()
+                self.tokens = min(self.burst, self.tokens+(now-self.last)*self.rate)
+                self.last = now
+                if self.tokens >= size:
+                    self.tokens -= size
+                    return
+                await asyncio.sleep(min(1.0, (size-self.tokens)/self.rate))
