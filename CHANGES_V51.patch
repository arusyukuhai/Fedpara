+                with self.db:
+                    self.db.execute("DELETE FROM lease WHERE manifest=? AND state='retiring'",(digest,))
+                removed.append(digest)
+            if removed:
+                self.db.execute('PRAGMA incremental_vacuum(128)')
+        return removed
